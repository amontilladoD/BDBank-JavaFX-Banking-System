<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bdbank.controller.RegisterController"
            fitToWidth="true" styleClass="app-bg" prefWidth="900" prefHeight="600">
    <content>
        <VBox alignment="TOP_CENTER" spacing="14" styleClass="app-bg">
            <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

            <VBox maxWidth="420" spacing="12" styleClass="card">
                <Label text="Create Your Account" styleClass="h1-label"/>
                <Label text="Your account will be reviewed and activated by the bank admin." styleClass="muted-label" wrapText="true"/>

                <TextField fx:id="nameField" promptText="Full Name"/>
                <TextField fx:id="nidField" promptText="NID Number"/>
                <TextField fx:id="phoneField" promptText="Phone (01XXXXXXXXX)"/>
                <TextField fx:id="emailField" promptText="Email Address"/>
                <ComboBox fx:id="typeBox" promptText="Account Type" maxWidth="Infinity"/>
                <PasswordField fx:id="pwField" promptText="Password (min 6 chars)"/>
                <PasswordField fx:id="pw2Field" promptText="Confirm Password"/>

                <Label fx:id="statusLabel" styleClass="error-label" wrapText="true"/>

                <Button text="Register" styleClass="btn-primary" maxWidth="Infinity" onAction="#onRegister"/>
                <Button text="Back to Login" styleClass="btn-secondary" maxWidth="Infinity" onAction="#onBackToLogin"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
